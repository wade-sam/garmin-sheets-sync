# Offline defaults do not use credentials or network access.
SYNC_SOURCE=fixture
SYNC_DESTINATION=sqlite
SYNC_LOOKBACK_DAYS=3
FIXTURE_PATH=fixtures/sample.json
SQLITE_PATH=.local/garmin-sync.db
SYNC_LOCK_FILE=.local/sync.lock
TZ=Europe/Paris
LOG_LEVEL=INFO

# Live Garmin source. Keep these in a local .env or secret manager, not Git.
GARMIN_EMAIL=
GARMIN_PASSWORD=
GARMIN_TOKEN_DIR=/data/garmin
GARMIN_RETRY_ATTEMPTS=3
GARMIN_RETRY_BASE_SECONDS=10
GARMIN_RETRY_MAX_SECONDS=60

# Live Google Sheets destination.
GOOGLE_SERVICE_ACCOUNT_FILE=/run/secrets/google-service-account.json
GOOGLE_SHEET_ID=
GOOGLE_SETTINGS_TAB=Settings
GOOGLE_LAST_SUCCESS_CELL=B2

# Leave blank until the per-activity route is confirmed against the live account.
GARMIN_ACTIVITY_URL_TEMPLATE=

# Failure alerts. Use "log" offline and "smtp" in production. Use "platform" only
# after a scheduled-job failure notification path is configured and tested.
ALERT_MODE=log
SMTP_HOST=
SMTP_PORT=587
SMTP_STARTTLS=true
SMTP_USERNAME=
SMTP_PASSWORD=
ALERT_EMAIL_FROM=
ALERT_EMAIL_TO=
